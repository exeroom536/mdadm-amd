prepare() {
	cd mdadm
	git apply "$srcdir"/mdadm-amd.patch

	# md-bitmap-ext-dkms: drivers/md of each base, with the fix
	cd "$srcdir"
	rm -rf md-tree
	local _b _f
	for _b in "${_mdbases[@]}"; do
		mkdir -p "md-tree/v$_b/drivers/md"
		for _f in "${_mdfiles[@]}"; do
			cp -L "v${_b}-${_f}" "md-tree/v$_b/drivers/md/$_f"
		done
		patch -d "md-tree/v$_b" -p1 --no-backup-if-mismatch -i "$srcdir/md-bitmap-ext.patch"
	done
}

build() {
	cd mdadm
	# CachyOS builds with -O3 and LTO: GCC then reports false positives in upstream code
	# (super-intel.c: format-truncation, maybe-uninitialized; super-ddf.c: maybe-uninitialized),
	# and the Makefile has -Werror. super-amd.c builds clean with these flags.
	CFLAGS+=' -Wno-error'
	make CXFLAGS="$CFLAGS" BINDIR=/usr/bin UDEVDIR=/usr/lib/udev everything
}

package_mdadm-amd() {
	pkgdesc='mdadm with AMD RAIDXpert2 (RAIDCore) metadata support, plus the amdraid mkinitcpio hook'
	depends=('glibc' 'systemd')
	optdepends=('bash: mdcheck'
	            'md-bitmap-ext-dkms: md write-intent bitmap of AMD volumes on Linux 6.18.57-6.18.63 and 7.3.0-7.3.4 (resync after a crash only where md was writing)')
	provides=("mdadm=${_mdadmver}")
	# mkinitcpio 40: HOOKS of the shutdown ramfs come from /run/initramfs/mkinitcpio-shutdown.conf
	# (tmpfiles 20-mkinitcpio.conf), which 60-amdraid-shutdown.conf appends to
	conflicts=('mdadm' 'mkinitcpio<40')
	backup=('etc/mdadm.conf')
	install=mdadm-amd.install

	cd mdadm
	make INSTALL=/usr/bin/install BINDIR=/usr/bin DESTDIR="$pkgdir" UDEVDIR=/usr/lib/udev install
	make SYSTEMD_DIR=/usr/lib/systemd/system BINDIR=/usr/bin DESTDIR="$pkgdir" install-systemd
	install -D -m644 ../mdadm.conf "$pkgdir"/etc/mdadm.conf

	install -Dm 644 raid6check.8 "$pkgdir"/usr/share/man/man8/raid6check.8
	install -Dm 755 raid6check "$pkgdir"/usr/bin/raid6check

	# AMD: libblkid does not know the RAIDCore label — udev offers whole disks to mdadm -I;
	# the amdraid hook (after block, needs the systemd hook) carries mdadm/mdmon into the initramfs.
	install -Dm 644 ../64-amd-raid-assembly.rules "$pkgdir"/usr/lib/udev/rules.d/64-amd-raid-assembly.rules
	install -Dm 644 ../initcpio-install-amdraid "$pkgdir"/usr/lib/initcpio/install/amdraid
	# shutdown: external-metadata arrays left clean, as recorded by mdmon, right before the power goes
	# (the root file system's array cannot be stopped): the amdraid-shutdown hook in the shutdown ramfs.
	install -Dm 644 ../initcpio-install-amdraid-shutdown "$pkgdir"/usr/lib/initcpio/install/amdraid-shutdown
	install -Dm 755 ../amdraid.shutdown "$pkgdir"/usr/lib/initcpio/amdraid.shutdown
	install -Dm 644 ../60-amdraid-shutdown.conf "$pkgdir"/usr/lib/tmpfiles.d/60-amdraid-shutdown.conf
}

package_md-bitmap-ext-dkms() {
	pkgdesc='md_mod with the write-intent bitmap fix for external metadata (DKMS, Linux 6.18.57-6.18.63, 7.3.0-7.3.4), until it is upstream'
	arch=('any')
	license=('GPL-2.0-only')
	depends=('dkms')
	url='https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/drivers/md'

	# the DKMS version takes no "-": the dkms pacman hook splits /usr/src/<name>-<version> at the last one
	local ver="${pkgver}.${pkgrel}" i kre=
	local dest="$pkgdir/usr/src/md-bitmap-ext-$ver"

	install -Dm644 -t "$dest" Kbuild
	install -Dm755 -t "$dest" dkms-pre-build.sh dkms-post-install.sh
	# one directory per base, and the table dkms-pre-build.sh picks it from
	for i in "${!_mdbases[@]}"; do
		install -Dm644 -t "$dest/v${_mdbases[i]}" "md-tree/v${_mdbases[i]}"/drivers/md/*
		printf '%s v%s\n' "${_mdkvers[i]}" "${_mdbases[i]}" >> "$dest/bases"
		kre+="${kre:+|}${_mdkvers[i]}"
	done
	chmod 644 "$dest/bases"
	# in bash, not sed: the backslashes of the regex would need escaping twice over
	local conf
	conf=$(<dkms.conf)
	conf=${conf//@PKGVER@/$ver}
	conf=${conf//@KVER_RE@/^($kre)-}
	printf '%s\n' "$conf" > "$dest/dkms.conf"
	chmod 644 "$dest/dkms.conf"
}
