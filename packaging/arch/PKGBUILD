# mdadm with AMD RAIDXpert2 (RAIDCore, metadata=amd) support - a replacement for the mdadm package of
# Arch Linux / CachyOS.  Based on the PKGBUILD of mdadm 4.6-2 in Arch
# (gitlab.archlinux.org/archlinux/packaging/packages/mdadm); upstream mdadm is pinned to the commit
# mdadm-amd.patch applies to.  Two packages from one build:
#   mdadm-amd          - mdadm, mkinitcpio hooks, udev rule; replaces mdadm;
#   md-bitmap-ext-dkms - optional: md_mod with the md fix for the write-intent bitmap of external
#                        metadata (kernel/), for Linux 6.18.57-6.18.63 and 7.3.0-7.3.4, until it is upstream.
# Build: cp ../../mdadm/mdadm-amd.patch ../dkms/* . && makepkg -s   (see docs/install.md)
# (after changing a file here: updpkgsums)

pkgbase=mdadm-amd
pkgname=('mdadm-amd' 'md-bitmap-ext-dkms')
_commit=5542bf40fab20f09ce3be80ae1cb42584e9fa2f7   # mdadm-4.6-112-g5542bf40, 2026-11-12 (GitHub main)
_mdadmver=4.6.r112.g5542bf40   # the mdadm it is built from (provides)
# the mdadm-amd release; a build between releases: <last release>.r<n>
pkgver=1.2
pkgrel=1
arch=('x86_64')
license=('GPL-2.0-or-later')
url='https://github.com/md-raid-utilities/mdadm'
makedepends=('git' 'man-db')

# md-bitmap-ext-dkms: drivers/md of these stable tags (the bases), and for each the kernel releases whose
# drivers/md files are the same (checked on a clone of stable: packaging/dkms/md-bases.sh); a kernel of any
# other release keeps its own md_mod
_mdbases=(6.18.57 6.18.61 6.18.63 7.3.1 7.3.4)
_mdkvers=('6\.18\.(5[7-9]|60)' '6\.18\.6[12]' '6\.18\.63' '7\.3\.[0-3]' '7\.3\.4')	# per base: regex of the kernel version up to its first "-"
_md="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/md"
_mdfiles=(md.c md.h md-bitmap.c md-bitmap.h md-llbitmap.c md-cluster.h)

source=("mdadm::git+https://github.com/md-raid-utilities/mdadm.git#commit=${_commit}"
        'mdadm-amd.patch'
        '64-amd-raid-assembly.rules'
        'initcpio-install-amdraid'
        'initcpio-install-amdraid-shutdown'
        'amdraid.shutdown'
        '60-amdraid-shutdown.conf'
        'mdadm.conf'
        'dkms.conf'
        'Kbuild'
        'dkms-pre-build.sh'
        'dkms-post-install.sh'
        'md-bitmap-ext.patch')
for _b in "${_mdbases[@]}"; do
	for _f in "${_mdfiles[@]}"; do
		source+=("v${_b}-${_f}::${_md}/${_f}?h=v${_b}")
	done
done
