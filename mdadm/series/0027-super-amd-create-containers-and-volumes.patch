+/* CacheTagSize for a chunk of @chunk_size bytes (see amd_chunk_sectors) */
+static __u32 amd_chunk_tag(int chunk_size)
+{
+	switch (chunk_size / 1024) {
+	case 128:
+		return 2;
+	case 256:
+		return 3;
+	default:
+		return 1;
+	}
+}
