+		return 1;
+	if (level == 10 && raiddisks >= 4 && raiddisks % 2 == 0)
+		return 1;
+	if (level == 5 && raiddisks >= 3 && raiddisks <= 8)
+		return 1;	/* rcadm: "three to eight disks" */
