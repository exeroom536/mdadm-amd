+		pr_err("AMD RAID volumes can be created as RAID0 (2 or more disks), RAID1 (2 disks), RAID10 (2 x n disks), RAID5 (3 to 8 disks), linear (Volume, 1 or more disks) or RAIDABLE (RAID1 of 1 disk: -l1 -n1 --force)\n");
