+static int amd_level_ok(int level, int raiddisks, int verbose)
+{
+	if (level == LEVEL_LINEAR && raiddisks >= 1)
+		return 1;	/* Volume (the menu: 1 to 8 disks) */
+	if (level == 0 && raiddisks >= 2)
+		return 1;
+	if (level == 1 && raiddisks == 2)
+		return 1;
