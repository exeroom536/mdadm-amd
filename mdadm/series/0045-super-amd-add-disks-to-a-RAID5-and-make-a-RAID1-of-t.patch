+/*
+ * RAID5 or RAID1 of two @ld getting data disks as RAID5 @t, the chunk the
+ * same (amd_grow_shape checked ID, First and chunk), as rcadm -T -r5 records
+ * it (q8m-e2mid: RAID5 3 -> 4; q8m-e3bmid: RAID1 -> RAID5 3): each element
+ * of @ld on its disk as the same element of @t, at the same extent start,
+ * its data moving from +0x5000 down to +0x800; the new elements on other
+ * disks, their data at +0x800 too; the capacity no less.  md reshapes that,
+ * moving data_offset as AMD moves the data.
+ */
+static int amd_disks_shape(const struct amd_ld *ld, const struct amd_ld *t)
+{
+	const struct amd_element *el = amd_ld_elements(ld);
+	const struct amd_element *tel = amd_ld_elements(t);
+	int i, j, n = amd_ld_nel(ld), nt = amd_ld_nel(t);
+	__u32 type = __le32_to_cpu(ld->device_type);
+
+	if (__le32_to_cpu(t->device_type) != AMD_LDT_RAID50 ||
+	    __le32_to_cpu(t->first_count) != 1 || nt <= n ||
+	    __le64_to_cpu(t->capacity) < __le64_to_cpu(ld->capacity))
+		return 0;
+	if (!(type == AMD_LDT_RAID50 && n >= 3) &&
+	    !(type == AMD_LDT_RAID10N && n == 2))
+		return 0;
+	for (i = 0; i < nt; i++) {
+		if (!amd_data_gap(&tel[i], AMD_MIB))
+			return 0;
+		if (i < n && (tel[i].id.id != el[i].id.id ||
+			      tel[i].allocated.offset != el[i].allocated.offset ||
+			      !amd_data_gap(&el[i], AMD_SERVICE)))
+			return 0;
+		for (j = 0; i >= n && j < n; j++)
+			if (tel[i].id.id == el[j].id.id)
+				return 0;
+	}
+	return AMD_GROW_RESHAPE;
+}
