+/*
+ * Volume sector an initialization or a check of @v that was stopped
+ * resumes from (amd_resync_transform): what its transform log says, short
+ * of the end so that md still resyncs and mdmon sees it finish.  md
+ * resyncs a mirror in volume sectors (RAID10: the array's).
+ */
+static unsigned long long amd_init_resume_point(struct amd_super *super,
+						struct amd_vol *v)
+{
+	unsigned long long cap = __le64_to_cpu(v->shape->capacity);
+	unsigned long long done;
+
+	if (!v->link)
+		return 0;
+	done = amd_tlog_read(super, v, v->link,
+			     __le32_to_cpu(v->ld->transform_type));
+	return amd_short_of_end(done, cap);
+}
