  * amd_load_disk does, with descriptors, writable if they can be - mdmon
@@ -1714,6 +1980,7 @@ static int load_super_amd(struct supertype *st, int fd, char *devname)
 static struct amd_super *amd_load_md(struct mdinfo *sra)
 {
 	struct amd_super *super = amd_new_super();
+	struct amd_disk *d;
 	struct mdinfo *sd;
 
 	for (sd = sra->devs; sd; sd = sd->next) {
@@ -1732,6 +1999,10 @@ static struct amd_super *amd_load_md(struct mdinfo *sra)
 		return NULL;
 	}
 	super->from_md = 1;
+	for (d = super->disks; d && !d->foreign; d = d->next)
+		;
+	if (d)
+		amd_find_taken(super);
 	return super;
 }
 
@@ -2337,6 +2608,19 @@ static int amd_volume_enough(struct amd_super *super, struct amd_vol *v)
 	return amd_volume_count(super, v, 0);
 }
 
