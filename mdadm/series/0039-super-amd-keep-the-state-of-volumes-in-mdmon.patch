 #define AMD_DEV_STATE_ONLINE	0x3000
+#define AMD_DEV_STATE_OFFLINE	0x3001
 
 /* RC_LogicalDeviceTypes */
 #define AMD_LDT_RAID50		0x1bf5	/* RAID5 when FirstCount == 1 */
@@ -80,12 +83,22 @@
 
