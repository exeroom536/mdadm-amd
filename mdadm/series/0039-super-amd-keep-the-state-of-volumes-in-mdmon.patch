+/* Data elements of one parity set (RC_SecondElementCount). */
+static unsigned int amd_data_per_set(const struct amd_ld *ld)
+{
+	__u32 s = __le32_to_cpu(ld->second_count);
+
+	switch (__le32_to_cpu(ld->device_type)) {
+	case AMD_LDT_RAID50:
+		return s - 1;
+	case AMD_LDT_RAID60:
+		return s - 2;
+	case AMD_LDT_RAW:
+		return s;
+	default:
+		return 1;
+	}
+}
