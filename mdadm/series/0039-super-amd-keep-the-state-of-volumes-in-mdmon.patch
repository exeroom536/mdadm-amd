+static unsigned int amd_bitmap_bits(const struct amd_vol *v)
+{
+	unsigned long long cover = amd_bitmap_cover(v);
+	unsigned long long cap = __le64_to_cpu(v->shape->capacity);
+
+	return cover ? (cap + cover - 1) / cover : 0;
+}
