+static void amd_trim_packet(struct amd_super *super);
+static void amd_reparse(struct amd_super *super);
+static void amd_reparse_without(struct amd_super *super, int gone);
+static struct active_array *amd_vol_array(struct supertype *st, int vol);
 static int amd_pd_index(struct amd_super *super, __u64 id);
 static int amd_disk_in_volumes(struct amd_super *super, __u64 id);
+static void amd_kmsg(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
 
 /*
  * Checksum used by every RAIDCore structure: xor of 64-bit words, each
@@ -505,6 +636,21 @@ static int amd_element_usable(const struct amd_element *el)
 	return el->id.id && !(__le32_to_cpu(el->flags) & AMD_ELEMENT_UNUSABLE);
 }
 
+/*
+ * @el is out of service as the AMD driver records a member it did not find
+ * (0x20 alone): nothing has written to the volume since - the first write
+ * adds 0x10 (rcblob RC_UpdateDriveErrors @0012f080; rcraid 9.3.3-00302,
+ * the ring of q11r-away: a RAID1 0x20 at start-up, 0x30 once written) -
+ * and nothing failed on it.
+ */
+static int amd_element_away(const struct amd_element *el)
+{
+	return el->id.id &&
+	       (__le32_to_cpu(el->flags) &
+		(AMD_ELEMENT_UNUSABLE | AMD_ELEMENT_FAIL_COMMITTED)) ==
+	       AMD_ELEMENT_MISSING;
+}
+
 static struct amd_element *amd_ld_elements(const struct amd_ld *ld)
 {
 	return (struct amd_element *)((char *)ld +
@@ -769,7 +915,23 @@ static int amd_equal_size(struct amd_vol *v, unsigned long long data_disks)
 	return 1;
 }
 
-/* md runs @v read-write or read-only: by its state and transform */
+/*
+ * Transform @type is one md runs as a resync, from where the volume's
+ * transform log has it (amd_init_resume_point), as the AMD driver resumes
+ * it (rcblob RC_RestartTask): an initialization, or a check the AMD driver
+ * left unfinished (Verify in Windows cut short by a power loss).  md has no
+ * check it could resume and record; its resync does what that check does
+ * and more: mirrors are copied from their first member, as rcadm -M -cs
+ * repairs a RAID10 from [i][0], and the parity of a RAID5 is put right,
+ * which the AMD check leaves as it is.
+ */
+static int amd_resync_transform(__u32 type)
+{
+	return type == AMD_TRANSFORM_CREATE_REDUNDANCY ||
+	       type == AMD_TRANSFORM_CHECK_REDUNDANCY;
+}
+
+/* mdmon manages @v, or md runs it read-only: by its state and transform */
 static void amd_classify_state(struct amd_vol *v)
 {
 	struct amd_ld *ld = v->ld;
@@ -794,14 +956,52 @@ static void amd_classify_state(struct amd_vol *v)
 	 */
 	if (state == AMD_LD_STATE_LOCKED)
 		state = AMD_LD_STATE_CRITICAL;
-	/* a transform not ended (initialization, rebuild, migration) */
-	transform = type &&
+	/*
+	 * Not a check of a volume gone critical since: the AMD driver checks
+	 * none (rcblob RC_CheckManageCheck), nor can md resync one.
+	 */
+	v->init_pending = amd_resync_transform(type) &&
+		(type != AMD_TRANSFORM_CHECK_REDUNDANCY ||
+		 state == AMD_LD_STATE_NORMAL) &&
 		__le32_to_cpu(ld->transform_state) != AMD_TRANSFORM_COMPLETED;
-	/* nothing is recorded for AMD yet: what has state stays read-only */
-	if (v->level == 0 || v->level == LEVEL_LINEAR)
+	/*
+	 * An initialization, a check or a rebuild left unfinished goes on
+	 * from the volume's transform log (amd_tlog_read).  Any other
+	 * transform is an AMD migration: only RAIDABLE -> RAID1 is supported
+	 * (v->grow), with any other the volume is not assembled.
+	 */
+	transform = type && !v->init_pending &&
+		__le32_to_cpu(ld->transform_state) != AMD_TRANSFORM_COMPLETED &&
+		ld->transform_state;
+	if (v->single) {
+		/*
+		 * md raid1 needs mdmon for its clean/active transitions even
+		 * with one member; an AMD RAIDABLE keeps no write-intent
+		 * bitmap (attribute 0), so there is nothing to record but
+		 * failures.
+		 */
+		v->managed = state == AMD_LD_STATE_NORMAL && !transform;
+		v->readonly = !v->managed;
+	} else if (v->level == 0 || v->level == LEVEL_LINEAR) {
 		v->readonly = state != AMD_LD_STATE_NORMAL || transform;
-	else
+	} else if ((v->level == 1 || v->level == 10 || v->level == 5) &&
+		   !transform &&
+		   (__le32_to_cpu(v->shape->attribute) & AMD_ATTR_BITMAP) &&
+		   (state == AMD_LD_STATE_NORMAL ||
+		    state == AMD_LD_STATE_CRITICAL)) {
+		/*
+		 * Mirrors and RAID5: mdmon records dirty/clean in the AMD
+		 * write-intent bitmap and member failures in the config
+		 * packet.  RAID5 is md raid5 right-asymmetric, checked against
+		 * the AMD Windows driver (rcraid.sys 9.3.3): md check finds the
+		 * parity it writes right, and it reads what md wrote with a
+		 * member missing, through md's parity.
+		 */
+		v->managed = 1;
+		v->readonly = 0;
+	} else {
 		v->readonly = 1;
+	}
 }
 
