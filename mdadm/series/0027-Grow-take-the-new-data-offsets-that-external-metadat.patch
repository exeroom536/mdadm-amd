From 141226e27bc11adc5fd5050b25093723148b6736 Mon Sep 17 00:00:00 2001
From: exeroom536 <352890649+exeroom536@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:53:08 +0500
Subject: [PATCH 27/53] Grow: take the new data offsets that external metadata
 records

A reshape that moves the data needs a new_offset for each device.
set_new_data_offset() works it out from the superblock of each device -
the same distance on every device - or takes the one --data-offset.  A
disk of a container has no superblock of the member array, and the
place the metadata moves the data to need not be the same distance on
every disk: AMD RAIDXpert2 (later in this series) moves the data of
every member down into its service area by 0x4800 sectors, from extents
that start differently on each disk, and its driver, going on with the
reshape after a crash, looks for them there.  The metadata handler
cannot set new_offset itself in reshape_super(): set_new_data_offset()
comes after it and sets its own, and once the reshape has started md
takes no other (EBUSY).

Let an external metadata handler that records where the data go give
each member's new_data_offset with container_content() after
reshape_super(), set those (set_metadata_data_offset()), and fall back
to set_new_data_offset() if it gives none - as every handler but that
one does: nothing changes for them.

Written by Claude Opus 5.5, an AI model by Anthropic.
---
 Grow.c | 62 ++++++++++++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 58 insertions(+), 4 deletions(-)

diff --git a/Grow.c b/Grow.c
index 2764a2ff..404d89a6 100644
--- a/Grow.c
+++ b/Grow.c
@@ -2728,6 +2728,53 @@ fallback:
 	return 1;
 }
 
+/**
+ * set_metadata_data_offset() - new data offsets external metadata records.
+ * @st: Supertype, its metadata changed by ->reshape_super() already.
+ * @info: The array, as Grow_reshape() or container_content() has it.
+ * @sra: Its devices in md.
+ *
+ * External metadata may record where the data of each member go in a
+ * reshape: ->container_content() gives the member's new_data_offset.  AMD
+ * moves the data of every member down into its service area by as much
+ * (0x4800 sectors), from extents that start differently on each disk - no
+ * one --data-offset, nor what set_new_data_offset() works out from the
+ * superblock of each device, puts them there.
+ *
+ * Return: 0 if it set them, 1 if the metadata records none, -1 on error.
+ */
+static int set_metadata_data_offset(struct supertype *st, struct mdinfo *info,
+				    struct mdinfo *sra)
+{
+	struct mdinfo *cc, *d, *sd;
+	char *subarray;
+	int rv = 1;
+
+	if (!st->ss->external || !st->ss->container_content)
+		return 1;
+	subarray = strchr(info->text_version + 1, '/');
+	cc = subarray ? st->ss->container_content(st, subarray + 1) : NULL;
+	if (!cc)
+		return 1;
+	for (sd = sra->devs; sd; sd = sd->next) {
+		for (d = cc->devs; d; d = d->next)
+			if (d->disk.major == sd->disk.major &&
+			    d->disk.minor == sd->disk.minor)
+				break;
+		if (!d || !d->new_data_offset ||
+		    d->new_data_offset == d->data_offset)
+			continue;
+		if (sysfs_set_num(sra, sd, "new_offset", d->new_data_offset) < 0) {
+			pr_err("Cannot set new_offset for %s\n", sd->sys_name);
+			rv = -1;
+			break;
+		}
+		rv = 0;
+	}
+	sysfs_free(cc);
+	return rv;
+}
+
 static int raid10_reshape(char *container, int fd, char *devname,
 			  struct supertype *st, struct mdinfo *info,
 			  struct reshape *reshape,
@@ -3137,6 +3184,7 @@ static int reshape_array(char *container, int fd, char *devname,
 	unsigned long blocks;
 	unsigned long long array_size;
 	int done;
+	int moved;
 	int *backup_fdp = NULL;
 	struct mdinfo *sra = NULL;
 	char buf[SYSFS_MAX_BUF_SIZE];
@@ -3468,11 +3516,17 @@ static int reshape_array(char *container, int fd, char *devname,
 	if (!info->reshape_active)
 		remove_backup_link(sra->sys_name);
 
+	if (!backup_file) {
+		int delta = reshape.after.data_disks - reshape.before.data_disks;
+
+		moved = set_metadata_data_offset(st, info, sra);
+		if (moved == 1)
+			moved = set_new_data_offset(sra, st, devname, delta,
+						    data_offset,
+						    reshape.min_offset_change, 1);
+	}
 	if (!backup_file)
-		switch(set_new_data_offset(sra, st, devname,
-					   reshape.after.data_disks - reshape.before.data_disks,
-					   data_offset,
-					   reshape.min_offset_change, 1)) {
+		switch (moved) {
 	case -1:
 		goto release;
 	case 0:
