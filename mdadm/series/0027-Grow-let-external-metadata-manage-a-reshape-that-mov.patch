From e3dcac813f7a39f7e98a236df1ffb281a2445eb2 Mon Sep 17 00:00:00 2001
From: exeroom536 <352890649+exeroom536@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:53:10 +0500
Subject: [PATCH 27/48] Grow: let external metadata manage a reshape that moves
 the data

When md can move the data (new_offset), reshape_array() starts the
reshape and returns: nothing watches it.  External metadata may record
where the reshape is, for other software to go on with it after a
crash - AMD RAIDXpert2 (later in this series) writes a transform log
before each region, and the AMD driver or BIOS goes on from its mark,
copying the region again from where the data were.  md then must not
run more than a region ahead of that record, nor may writes go to a
region it copies before the record covers it.

For metadata with ->manage_reshape(), start such a reshape the way one
with a backup starts - held by sync_max, in a child that calls
->manage_reshape() - only without the backup: md moves the data out of
the way itself.  Metadata without ->manage_reshape() and native arrays
go on as before.

Written by Claude Opus 5.5, an AI model by Anthropic.
---
 Grow.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/Grow.c b/Grow.c
index 404d89a6..b0369c30 100644
--- a/Grow.c
+++ b/Grow.c
@@ -3185,6 +3185,7 @@ static int reshape_array(char *container, int fd, char *devname,
 	unsigned long long array_size;
 	int done;
 	int moved;
+	bool no_backup = false;
 	int *backup_fdp = NULL;
 	struct mdinfo *sra = NULL;
 	char buf[SYSFS_MAX_BUF_SIZE];
@@ -3530,7 +3531,18 @@ static int reshape_array(char *container, int fd, char *devname,
 	case -1:
 		goto release;
 	case 0:
-		/* Updated data_offset, so it's easy now */
+		/*
+		 * Updated data_offset, so it's easy now - unless external
+		 * metadata records how far the reshape is (AMD: other software
+		 * goes on with it from there after a crash).  Then md must not
+		 * run ahead of that record: started as with a backup, held at
+		 * the start by sync_max, ->manage_reshape() lets it on as far
+		 * as it records.
+		 */
+		if (st->ss->external && st->ss->manage_reshape) {
+			no_backup = true;
+			goto started;
+		}
 		update_cache_size(container, sra, info,
 				  min(reshape.before.data_disks,
 				      reshape.after.data_disks),
@@ -3598,7 +3610,7 @@ started:
 		 */
 		while (blocks * 32 < sra->component_size && blocks < 16*1024*2)
 			blocks *= 2;
-	} else
+	} else if (!no_backup)
 		pr_err("Need to backup %luK of critical section..\n", blocks/2);
 
 	if (blocks >= sra->component_size/2) {
-- 
