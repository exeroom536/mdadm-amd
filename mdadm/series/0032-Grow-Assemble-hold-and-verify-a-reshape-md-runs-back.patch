From bd1da305a5a326694ed081f9a068e7b8ee849b65 Mon Sep 17 00:00:00 2001
From: exeroom536 <352890649+exeroom536@users.noreply.github.com>
Date: Fri, 20 Nov 2026 12:55:12 +0500
Subject: [PATCH 32/54] Grow, Assemble: hold and verify a reshape md runs
 backwards where it is

md reshapes an array backwards - from the end - with fewer data disks,
and with as many when the data move up: md takes a higher new_offset
only for a reshape backwards (md.c new_offset_store).  External metadata
may record new data offsets above the old ones for
set_metadata_data_offset() (the next patch has it set them): AMD
RAIDXpert2 (later in this series) takes data an earlier migration moved
down back up for another chunk, as its driver would.  impose_reshape()
and start_reshape() take a reshape for one backwards only with fewer
data disks: such a reshape is started from 0 and held at
reshape_progress / data_disks (a RAID10 at reshape_progress) - but md
counts the progress of a reshape backwards from the end (raid5.c,
raid10.c reshape_request: sync_max is how far from the end), and would
run unheld, ahead of what ->manage_reshape() records.  So too do
verify_reshape_position(), for --grow --continue - what
mdadm-grow-continue@ runs, the reshape handed to it by mdadm --grow
under systemd -, and Assemble, for an array whose container has another
reshape in hand, read and set sync_max as from the start.

Take the direction from md (reshape_direction, set before the reshape
starts) and start such a reshape from the end of the array
(reshape_array_size(): Grow.c counts the data disks of a RAID10 with its
copies, which would make it twice its size), held where it goes on from,
counted from the end, in one place (reshape_held_sync_max()): as it
starts, as it goes on after assembly and as Assemble holds it, for a
RAID5 and for a RAID10 (which md counts in sectors of the array) alike,
until ->manage_reshape() lets it on.  Held at 0 wherever it went on
from, it would be held below the sync_max of a reshape md runs, which md
refuses (md.c max_sync_store: EBUSY).  Read sync_max back so in
verify_reshape_position(): md is ahead of the metadata below its
progress.  A native array whose data move up (set_new_data_offset())
passes impose_reshape() too, but md runs it without start_reshape(),
unheld, as before; IMSM and DDF do not move the data.

Written by Claude Opus 5.5, an AI model by Anthropic.
---
 Assemble.c |  21 +++++++---
 Grow.c     | 113 ++++++++++++++++++++++++++++++++++++++++++-----------
 mdadm.h    |   3 ++
 3 files changed, 109 insertions(+), 28 deletions(-)

diff --git a/Assemble.c b/Assemble.c
index 100d49c2..d70727a2 100644
--- a/Assemble.c
+++ b/Assemble.c
@@ -2326,15 +2326,24 @@ int assemble_container_content(struct supertype *st, int mdfd,
 		if (st->ss->external &&
 		    container_reshape_pending(st->container_devnm,
 					      content->sys_name)) {
-			/* md counts a RAID10 reshape in sectors of the array */
-			int data = content->array.level == 10 ? 1 :
-				   get_data_disks(content->array.level,
-						  content->new_layout,
-						  content->array.raid_disks);
+			int level = content->array.level;
+			int disks = content->array.raid_disks;
+			int before = disks - content->delta_disks;
+			int data = disks;
 			unsigned long long held = 0;
 
+			/* data disks as Grow.c counts them: a RAID10's with its copies */
+			if (level != 10) {
+				data = get_data_disks(level, content->new_layout,
+						      disks);
+				before = get_data_disks(level,
+							content->array.layout,
+							before);
+			}
+
 			if (data > 0)
-				held = content->reshape_progress / data;
+				held = reshape_held_sync_max(content, before,
+							     data);
 			err = sysfs_set_num(content, NULL, "sync_max", held);
 			if (!err && c->verbose >= 0)
 				pr_err("%s: its reshape goes on after that of another array of the container\n",
diff --git a/Grow.c b/Grow.c
index d09416c7..f0d3230a 100644
--- a/Grow.c
+++ b/Grow.c
@@ -910,6 +910,55 @@ static int subarray_set_num(char *container, struct mdinfo *sra, char *name, int
 	return rc;
 }
 
+/*
+ * md reshapes @sra from the end: with fewer data disks, or moving the
+ * data up (external metadata recorded that: set_metadata_data_offset()).
+ */
+static bool md_reshape_backwards(struct mdinfo *sra, int before_data_disks,
+				 int data_disks)
+{
+	char dir[SYSFS_MAX_BUF_SIZE];
+
+	return before_data_disks > data_disks ||
+	       (sysfs_get_str(sra, NULL, "reshape_direction", dir,
+			      sizeof(dir)) > 0 &&
+		strncmp(dir, "backwards", 9) == 0);
+}
+
+/*
+ * Sectors of the array @sra spans, @data_disks as Grow.c counts those of
+ * a RAID10: with its copies.
+ */
+static unsigned long long reshape_array_size(struct mdinfo *sra,
+					     int data_disks)
+{
+	unsigned long long size = sra->component_size * data_disks;
+	int layout = sra->array.layout;
+
+	if (sra->array.level == 10)
+		size /= (layout & 255) * ((layout >> 8) & 255);
+	return size;
+}
+
+/*
+ * sync_max that holds the reshape of @sra at its reshape_progress (in
+ * sectors of the array): md counts a RAID10 reshape in sectors of the
+ * array (raid10.c reshape_request), another in sectors of a member of the
+ * new layout - and one it runs from the end, from there.  @data_disks as
+ * Grow.c counts them (reshape_array_size()).
+ */
+unsigned long long reshape_held_sync_max(struct mdinfo *sra,
+					 int before_data_disks, int data_disks)
+{
+	unsigned long long done = sra->reshape_progress;
+
+	if (md_reshape_backwards(sra, before_data_disks, data_disks))
+		done = reshape_array_size(sra, data_disks) - done;
+	if (sra->array.level != 10)
+		done /= data_disks;
+	return done;
+}
+
 int start_reshape(struct mdinfo *sra, int already_running,
 		  int before_data_disks, int data_disks, struct supertype *st)
 {
@@ -923,20 +972,19 @@ int start_reshape(struct mdinfo *sra, int already_running,
 		err = err ?: sysfs_set_num(sra, NULL, "suspend_lo",
 					   sra->reshape_progress);
 	}
-	if (sra->array.level == 10)
-		/*
-		 * md counts the reshape of a RAID10 in sectors of the array
-		 * (raid10.c reshape_request), not of a member of the new
-		 * layout as that of a RAID5: held where it goes on from.
-		 * Divided by the data disks, that need not be a multiple of
-		 * the chunk, as md requires (md.c max_sync_store).
-		 */
-		sync_max_to_set = sra->reshape_progress;
-	else if (before_data_disks <= data_disks)
-		sync_max_to_set = sra->reshape_progress / data_disks;
-	else
+	if (before_data_disks > data_disks)
 		sync_max_to_set = (sra->component_size * data_disks
 				   - sra->reshape_progress) / data_disks;
+	else
+		/*
+		 * Held where it goes on from until ->manage_reshape() lets
+		 * it on: the data moving up, md counts from the end (0 at the
+		 * start).  A RAID10 one divided by the data disks need not be
+		 * a multiple of the chunk, as md requires (md.c
+		 * max_sync_store).
+		 */
+		sync_max_to_set = reshape_held_sync_max(sra, before_data_disks,
+							data_disks);
 
 	if (!already_running)
 		sysfs_set_num(sra, NULL, "sync_min", sync_max_to_set);
@@ -2461,20 +2509,39 @@ static int verify_reshape_position(struct mdinfo *info, int level)
 
 		dprintf("Read sync_max sysfs entry is: %s\n", buf);
 		if (!(ep == buf || (*ep != 0 && *ep != '\n' && *ep != ' '))) {
+			int data_disks = get_data_disks(level, info->new_layout,
+							info->array.raid_disks);
+			int before = get_data_disks(level, info->array.layout,
+						    info->array.raid_disks -
+						    info->delta_disks);
+			bool md_ahead;
+
 			/*
 			 * md counts a RAID10 reshape in sectors of the array
 			 * (raid10.c reshape_request), and so is it held.
 			 */
 			if (level != 10)
-				position *= get_data_disks(level,
-							   info->new_layout,
-							   info->array.raid_disks);
-			if (info->reshape_progress < position) {
+				position *= data_disks;
+			/*
+			 * One md runs from the end it holds as far from there
+			 * (reshape_held_sync_max()), and md is ahead below the
+			 * progress the metadata records.
+			 */
+			if (md_reshape_backwards(info, before, data_disks)) {
+				unsigned long long size =
+					info->component_size * data_disks;
+
+				position = position < size ? size - position : 0;
+				md_ahead = info->reshape_progress > position;
+			} else {
+				md_ahead = info->reshape_progress < position;
+			}
+			if (md_ahead) {
 				dprintf("Corrected reshape progress (%llu) to md position (%llu)\n",
 					info->reshape_progress, position);
 				info->reshape_progress = position;
 				ret_val = 1;
-			} else if (info->reshape_progress > position) {
+			} else if (info->reshape_progress != position) {
 				pr_err("Fatal error: array reshape was not properly frozen (expected reshape position is %llu, but reshape progress is %llu.\n",
 				       position, info->reshape_progress);
 				pr_err("Reassemble array to try to restore critical sector.\n");
@@ -2989,10 +3056,12 @@ static int impose_reshape(struct mdinfo *sra,
 		sra->reshape_progress = info->reshape_progress;
 	} else {
 		sra->reshape_progress = 0;
-		if (reshape->after.data_disks < reshape->before.data_disks)
+		if (md_reshape_backwards(sra, reshape->before.data_disks,
+					 reshape->after.data_disks))
 			/* start from the end of the new array */
-			sra->reshape_progress = (sra->component_size
-						 * reshape->after.data_disks);
+			sra->reshape_progress =
+				reshape_array_size(sra,
+						   reshape->after.data_disks);
 	}
 
 	md_get_array_info(fd, &array);
@@ -3296,7 +3365,7 @@ static int reshape_array(char *container, int fd, char *devname,
 		/* Need 'sra' down at 'started:' */
 		sra = sysfs_read(fd, NULL,
 				 GET_COMPONENT|GET_DEVS|GET_OFFSET|GET_STATE|
-				 GET_CHUNK|GET_CACHE|GET_LEVEL);
+				 GET_CHUNK|GET_CACHE|GET_LEVEL|GET_LAYOUT);
 		if (!sra) {
 			pr_err("%s: Cannot get array details from sysfs\n",
 			       devname);
@@ -3546,7 +3615,7 @@ static int reshape_array(char *container, int fd, char *devname,
 	}
 	sra = sysfs_read(fd, NULL,
 			 GET_COMPONENT|GET_DEVS|GET_OFFSET|GET_STATE|GET_CHUNK|
-			 GET_CACHE|GET_LEVEL);
+			 GET_CACHE|GET_LEVEL|GET_LAYOUT);
 	if (!sra) {
 		pr_err("%s: Cannot get array details from sysfs\n",
 			devname);
diff --git a/mdadm.h b/mdadm.h
index 176f50d8..6bc143c3 100644
--- a/mdadm.h
+++ b/mdadm.h
@@ -1476,6 +1476,9 @@ extern int Grow_reshape(char *devname, int fd,
 			struct context *c, struct shape *s);
 extern int Grow_restart(struct supertype *st, struct mdinfo *info,
 			int *fdlist, int cnt, char *backup_file, int verbose);
+extern unsigned long long reshape_held_sync_max(struct mdinfo *sra,
+						int before_data_disks,
+						int data_disks);
 extern int Grow_continue(int mdfd, struct supertype *st,
 			 struct mdinfo *info, int forked, struct context *c);
 extern int Grow_consistency_policy(char *devname, int fd,
