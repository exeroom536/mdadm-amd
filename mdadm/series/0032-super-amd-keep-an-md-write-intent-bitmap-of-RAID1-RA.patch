+		pr_err("an AMD volume gets an md bitmap as it is created, or with --update-subarray=N --update=bitmap\n");
+		return -EINVAL;
+	}
+	v = &super->vol[super->new_vol];
+	if (*chunkp != UnSet && *chunkp > 0)
+		want = *chunkp / AMD_SECTOR;
