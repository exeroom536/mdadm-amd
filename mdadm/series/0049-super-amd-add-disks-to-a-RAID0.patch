+	if (!amd_data_gap(amd_ld_elements(v->ld), AMD_MIB))
+		return protect;
+	unit = amd_common_stripe(v->ld, v->shape);
+	room = mark / ss > mark / ts ? ts * (mark / ss - mark / ts) : 0;
+	return room >= protect ? protect : room - room % unit;
