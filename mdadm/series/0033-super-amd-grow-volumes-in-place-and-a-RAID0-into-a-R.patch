+
+/*
+ * A migration of LD @ld into LD @t that md runs as @t, as rcadm -T records
+ * them (rcraid 9.3.3-00302): AMD_GROW_SIZE - a mirror or a RAID5 of the same
+ * type and shape, every element where it was and larger, and so the
+ * capacity (q8m-e3dpost); AMD_GROW_MIRRORS - a RAID0 of N disks becoming the
+ * RAID10 N x 2 of its capacity, its element i as [i][0] and [i][1] a new
+ * mirror as large (q8m-e3amid).  0: neither (RAIDABLE -> RAID1 is
+ * amd_grow_link's, md runs it with the RAIDABLE's shape).
+ */
+static int amd_grow_shape(const struct amd_ld *ld, const struct amd_ld *t)
+{
+	const struct amd_element *el, *tel;
+	__u32 s;
+	int i, n;
+
+	if (t->id.id != ld->id.id || t->device_type != ld->device_type ||
+	    t->first_count != ld->first_count ||
+	    t->cache_tag_size != ld->cache_tag_size)
+		return 0;
+	el = amd_ld_elements(ld);
+	tel = amd_ld_elements(t);
+	n = amd_ld_nel(ld);
+	s = __le32_to_cpu(ld->second_count);
+	if (t->second_count == ld->second_count) {
+		/* md resizes no RAID0 (Grow.c) nor a Volume */
+		if ((__le32_to_cpu(ld->device_type) != AMD_LDT_RAID10N || s < 2) &&
+		    __le32_to_cpu(ld->device_type) != AMD_LDT_RAID50)
+			return 0;
+		if (__le64_to_cpu(t->capacity) <= __le64_to_cpu(ld->capacity))
+			return 0;
+		for (i = 0; i < n; i++)
+			if (!amd_element_kept(&tel[i], &el[i]) ||
+			    __le64_to_cpu(tel[i].user_data.size) <=
+			    __le64_to_cpu(el[i].user_data.size))
+				return 0;
+		return AMD_GROW_SIZE;
+	}
+	if (__le32_to_cpu(ld->device_type) != AMD_LDT_RAID10N || s != 1 ||
+	    __le32_to_cpu(t->second_count) != 2 || t->capacity != ld->capacity)
+		return 0;
+	for (i = 0; i < n; i++)
+		if (!amd_element_kept(&tel[2 * i], &el[i]) ||
+		    tel[2 * i].user_data.size != el[i].user_data.size ||
+		    tel[2 * i + 1].user_data.size != el[i].user_data.size)
+			return 0;
+	return AMD_GROW_MIRRORS;
+}
+
+/* the migration recorded for @v that md runs as the LD it makes (amd_grow_shape) */
+static int amd_grow_kind(const struct amd_vol *v)
+{
+	if (!v->link ||
+	    __le32_to_cpu(v->ld->transform_type) != AMD_TRANSFORM_NORMAL)
+		return 0;
+	return amd_grow_shape(v->ld, v->link);
