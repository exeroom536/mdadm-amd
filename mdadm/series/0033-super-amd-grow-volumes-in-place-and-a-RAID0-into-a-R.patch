+/* element @a is element @b where it was: the same disk, extent and data start */
+static int amd_element_kept(const struct amd_element *a,
+			    const struct amd_element *b)
+{
+	return a->id.id == b->id.id && a->allocated.offset == b->allocated.offset &&
+	       a->user_data.offset == b->user_data.offset;
