+			el = amd_link_elements(v);
+			n = amd_link_nel(v);
+		} else if (j == 2) {
+			if (!v->mon.rebuilding)
+				continue;
+			el = &v->mon.rebuild_el;
+			n = 1;
+		}
+		for (i = 0; i < n; i++) {
+			unsigned long long o = __le64_to_cpu(el[i].allocated.offset);
+			unsigned long long s = __le64_to_cpu(el[i].allocated.size);
