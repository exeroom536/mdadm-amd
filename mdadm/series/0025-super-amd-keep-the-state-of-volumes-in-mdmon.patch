+		v->managed = 1;
+		v->readonly = 0;
+	} else {
 		v->readonly = 1;
+	}
 }
 
 /*
@@ -1194,6 +1327,15 @@ static struct amd_disk *amd_find_disk(struct amd_super *super, __u64 id)
