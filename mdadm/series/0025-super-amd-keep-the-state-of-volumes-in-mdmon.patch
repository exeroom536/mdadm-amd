+		   !transform &&
+		   (__le32_to_cpu(ld->attribute) & AMD_ATTR_BITMAP) &&
+		   (state == AMD_LD_STATE_NORMAL ||
+		    state == AMD_LD_STATE_CRITICAL)) {
