-/* md runs @v read-write or read-only: by its state and transform */
+/* mdmon manages @v, or md runs it read-only: by its state and transform */
 static void amd_classify_state(struct amd_vol *v)
 {
 	struct amd_ld *ld = v->ld;
@@ -778,14 +878,47 @@ static void amd_classify_state(struct amd_vol *v)
 	 */
 	if (state == AMD_LD_STATE_LOCKED)
 		state = AMD_LD_STATE_CRITICAL;
-	/* a transform not ended (initialization, rebuild, migration) */
-	transform = ld->transform_type &&
