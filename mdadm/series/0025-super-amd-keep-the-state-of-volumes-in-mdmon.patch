+		goto refuse;
+	d = amd_find_disk(super, u->id);
+	if (u->commit_valid && u->generation <= super->generation &&
+	    (!d || d->fd < 0)) {
+		if (!d) {
+			d = rec;
+			rec = NULL;
+			d->device_id = u->id;
+			d->fd = -1;
+			amd_add_disk(super, d);
+		} else {
