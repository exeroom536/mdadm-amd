  * Up to date - or, for a volume without redundancy, with an older
@@ -1564,6 +1714,8 @@ static struct amd_super *amd_new_super(void)
 	struct amd_super *super = xcalloc(1, sizeof(*super));
 
 	super->current_vol = -1;
+	super->iobuf = amd_alloc(AMD_SECTOR);
