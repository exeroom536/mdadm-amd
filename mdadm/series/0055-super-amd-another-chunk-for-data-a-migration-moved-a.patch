+/*
+ * manage_reshape_amd for data going back up (amd_data_up): md reshapes
+ * backwards, from the end, as the AMD driver moves them - its regions of
+ * ProtectSize from 0 on, from the last, the one up to the capacity
+ * (RC_TransformUpdateNextRegionFromEnd @0014d910), whole stripes of both
+ * layouts (0x4800 sectors a data element).  For each region the log first
+ * - all above it moved, the AMD driver copies it again from where its
+ * data were (amd_tlog_fill) -, then the window of writes held is lowered
+ * over it (suspend_lo first: it never opens over the region), then md is
+ * let down to its start.  md counts such a reshape from the end
+ * (raid5.c, raid10.c reshape_request: sync_completed, sync_max), in the
+ * units of manage_reshape_amd.  Below the region md writes nothing: the
+ * new layout of what it moves lies 0x4800 sectors above the old.
+ * Stopped (SIGTERM), as the other way: the region in work finished,
+ * logged at its end.  1 if md has moved it all.
+ */
+static int amd_reshape_up(struct supertype *st, struct mdinfo *sra,
+			  struct amd_vol *v, unsigned long long end,
+			  unsigned long long unit, int fd)
+{
+	unsigned long long protect = amd_protect_size(v);
+	unsigned long long cap = __le64_to_cpu(v->link->capacity);
+	unsigned long long mark = amd_reshape_mark(st->sb, v), next;
+	int ok = 1;
+
+	/*
+	 * From the log, not from Grow.c's mark: going on with a reshape md
+	 * runs already, Grow.c takes the sync_max the manager before held md
+	 * at for where md is (verify_reshape_position) - the end of a region
