From b61287f022b502b93a246ca5010efe8f170f76a9 Mon Sep 17 00:00:00 2001
From: exeroom536 <352890649+exeroom536@users.noreply.github.com>
Date: Fri, 20 Nov 2026 12:55:12 +0500
Subject: [PATCH 33/54] Grow, sysfs: move the data of a reshape up as external
 metadata records it

External metadata may move the data of a reshape up: AMD RAIDXpert2
(later in this series) takes data an earlier migration moved down back
up 0x4800 sectors for another chunk, as its driver would.  md takes a
higher new_offset only for a reshape backwards, and only of a device
that reaches the data there (md.c new_offset_store); the size of a
device cannot change once its offsets differ (rdev_size_store).
set_metadata_data_offset() and sysfs_add_disk() write new_offset alone:
md refuses such an offset, and the reshape neither starts nor goes on
after assembly.

So, where the new_data_offset ->container_content() gives is above the
offset: the direction ("backwards") first, the device as large as
->container_content() gives it, then the new offset - as the reshape
starts (set_metadata_data_offset(); not for a device md has that offset
of already: going on) and as it goes on after assembly
(sysfs_add_disk(), which writes the size before already).  New offsets
below the old ones, and metadata that gives none, go as before.

Written by Claude Opus 5.5, an AI model by Anthropic.
---
 Grow.c  | 15 ++++++++++++++-
 sysfs.c |  5 ++++-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/Grow.c b/Grow.c
index f0d3230a..33e935a6 100644
--- a/Grow.c
+++ b/Grow.c
@@ -2831,7 +2831,11 @@ fallback:
  * moves the data of every member down into its service area by as much
  * (0x4800 sectors), from extents that start differently on each disk - no
  * one --data-offset, nor what set_new_data_offset() works out from the
- * superblock of each device, puts them there.
+ * superblock of each device, puts them there.  Moving them up (AMD: back
+ * up, to another chunk), md reshapes backwards, and takes the new offset
+ * only of a device that reaches the data there (md.c new_offset_store):
+ * the direction first, and the device as large as ->container_content()
+ * gives it, while its offset is the one it has (rdev_size_store).
  *
  * Return: 0 if it set them, 1 if the metadata records none, -1 on error.
  */
@@ -2856,6 +2860,15 @@ static int set_metadata_data_offset(struct supertype *st, struct mdinfo *info,
 		if (!d || !d->new_data_offset ||
 		    d->new_data_offset == d->data_offset)
 			continue;
+		if (d->new_data_offset > d->data_offset &&
+		    sd->new_data_offset != d->new_data_offset &&
+		    (sysfs_set_str(sra, NULL, "reshape_direction",
+				   "backwards") < 0 ||
+		     sysfs_set_num(sra, sd, "size", d->component_size / 2) < 0)) {
+			pr_err("Cannot move the data of %s up\n", sd->sys_name);
+			rv = -1;
+			break;
+		}
 		if (sysfs_set_num(sra, sd, "new_offset", d->new_data_offset) < 0) {
 			pr_err("Cannot set new_offset for %s\n", sd->sys_name);
 			rv = -1;
diff --git a/sysfs.c b/sysfs.c
index 1f14507f..36f9d707 100644
--- a/sysfs.c
+++ b/sysfs.c
@@ -1070,8 +1070,11 @@ int sysfs_add_disk(struct mdinfo *sra, struct mdinfo *sd, int resume)
 	 * new_data_offset) goes on only with the offset it moves them to -
 	 * else md would go on with new_offset = offset, over data not moved
 	 * yet.  After "size": md takes no size for a device whose offset
-	 * changes.
+	 * changes.  Moving them up, md goes on backwards: the direction first,
+	 * md takes a higher offset only so (new_offset_store).
 	 */
+	if (sra->reshape_active && sd->new_data_offset > sd->data_offset)
+		rv |= sysfs_set_str(sra, NULL, "reshape_direction", "backwards");
 	if (sra->reshape_active && sd->new_data_offset &&
 	    sd->new_data_offset != sd->data_offset)
 		rv |= sysfs_set_num(sra, sd, "new_offset", sd->new_data_offset);
