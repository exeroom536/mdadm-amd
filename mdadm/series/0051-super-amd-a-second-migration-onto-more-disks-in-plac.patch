+	r->start = start;
+	r->size = protect;
+	r->step = protect;
+	r->data_log = 0;
+	if (amd_data_gap(amd_ld_elements(v->ld), AMD_MIB)) {
+		unit = amd_dynamic_unit(v->ld, v->shape);
+		room = start / ss > start / ts ? ts * (start / ss - start / ts) : 0;
+		if (room < protect)
+			r->size = room >= unit ? room - room % unit : unit;
+		r->step = r->size;
