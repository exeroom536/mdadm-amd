+/* a stripe of @ld's data elements, sectors (RC_InitTransformStruct) */
+static unsigned long long amd_stripe_sectors(const struct amd_ld *ld)
+{
+	return amd_stripe_columns(ld) * (unsigned long long)amd_chunk_sectors(ld);
+}
+
+/*
+ * Where a migration of LD @s into LD @t that leaves the data in place
+ * stops logging them (rcblob RC_InitTransformStruct @00192fd0,
+ * LogDataRange): the stripes of the larger stripe to hold the smaller
+ * one's data elements over, one more.  RAID0 3 -> 4 at 64 KiB: 0x600.
+ * Below it the new layout is written where the old one is still to be
+ * read - md would not go on from there ("reshape_position too early").
+ */
+static unsigned long long amd_log_data_range(const struct amd_ld *s,
+					     const struct amd_ld *t)
+{
+	unsigned long long ss = amd_stripe_sectors(s), ts = amd_stripe_sectors(t);
+
+	if (ss < ts)
+		return ts * (ss * amd_stripe_columns(s) / ts + 1);
+	return ss * (ts * amd_stripe_columns(t) / ss + 1);
+}
+
+/*
+ * The unit of the regions of such a migration (rcblob
+ * RC_TransformDynamicProtectSize @0018c310): a stripe of both if both are
+ * RAID5, else a stripe of the LD made.
+ */
+static unsigned long long amd_dynamic_unit(const struct amd_ld *s,
+					   const struct amd_ld *t)
+{
+	if (__le32_to_cpu(s->device_type) == AMD_LDT_RAID50 &&
+	    __le32_to_cpu(t->device_type) == AMD_LDT_RAID50)
+		return amd_common_stripe(s, t);
+	return amd_stripe_sectors(t);
