+	if (__le32_to_cpu(t->type) == AMD_TRANSFORM_NORMAL &&
+	    (__le32_to_cpu(t->flags) & AMD_TFLAGS_DYNAMIC) && io > start &&
+	    io - start < __le32_to_cpu(t->protect_size))
+		return io;
