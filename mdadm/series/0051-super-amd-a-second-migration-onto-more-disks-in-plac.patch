+/*
+ * The disks of the elements of @ld, by element, for the data of a
+ * migration (amd_disk_wfd: past the page cache, md writes them below it);
+ * -1 for one out of service or not here.  amd_put_fds closes them.
+ */
+static void amd_get_fds(struct amd_super *super, const struct amd_ld *ld,
+			int *fds)
+{
+	const struct amd_element *el = amd_ld_elements(ld);
+	int i;
+
+	for (i = 0; i < amd_ld_nel(ld); i++) {
+		struct amd_disk *d = amd_find_disk(super,
+						   __le64_to_cpu(el[i].id.id));
+
+		fds[i] = d && amd_element_usable(&el[i]) ? amd_disk_wfd(d) : -1;
+	}
+}
+
+static void amd_put_fds(struct amd_super *super, const struct amd_ld *ld,
+			int *fds)
+{
+	const struct amd_element *el = amd_ld_elements(ld);
+	int i;
+
+	for (i = 0; i < amd_ld_nel(ld); i++) {
+		struct amd_disk *d = amd_find_disk(super,
+						   __le64_to_cpu(el[i].id.id));
+
+		if (is_fd_valid(fds[i]) && (!d || fds[i] != d->fd))
+			close(fds[i]);
+		fds[i] = -1;
+	}
+}
