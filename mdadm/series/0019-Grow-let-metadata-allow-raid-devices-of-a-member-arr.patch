From d74101a353e12b9737c4a5c8e447e6c7a5498763 Mon Sep 17 00:00:00 2001
From: exeroom536 <352890649+exeroom536@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:34:33 +0500
Subject: [PATCH 19/33] Grow: let metadata allow --raid-devices of a member
 array

Commit 20e114e334ed ("Grow: block -n on external volumes.") refused
--raid-devices for every member array of a container: with IMSM the
number of disks belongs to the container, and growing one volume only
made a mess.  Other metadata keeps that number per member array: AMD
RAIDXpert2 turns a one-disk volume (RAIDAble) into a RAID1 by adding
a second member, so "mdadm --grow /dev/md/raidable --raid-devices=2" is
the operation there, and the container has no number of disks of its
own.

Add superswitch.subarray_raid_disks and refuse --raid-devices of a
member array only when it is not set.  For such a member array take the
spares it may use from container_content(), as Grow_reshape() already
does further down for the other changes (now a helper,
get_subarray_spares()): md knows of no spares of a member array, so the
"Need N spares" check would otherwise always fail.

IMSM and DDF do not set the flag and behave as before.

Written by Claude Opus 5.5, an AI model by Anthropic.
---
 Grow.c  | 36 +++++++++++++++++++++++++-----------
 mdadm.h |  6 ++++++
 2 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/Grow.c b/Grow.c
index c49df9e5..a65a5e24 100644
--- a/Grow.c
+++ b/Grow.c
@@ -1853,6 +1853,26 @@ error:
 	return 1;
 }
 
+/**
+ * get_subarray_spares() - spares a subarray of external metadata may take.
+ * @st: Supertype, the container loaded.
+ * @subarray: Subarray.
+ * @array: Its array info, spare_disks set here.
+ *
+ * A subarray has no spares of its own in md: they are the container's, and
+ * the metadata says how many of them the subarray may take (container_content).
+ */
+static void get_subarray_spares(struct supertype *st, char *subarray,
+				mdu_array_info_t *array)
+{
+	struct mdinfo *info = st->ss->container_content(st, subarray);
+
+	if (info) {
+		array->spare_disks = info->array.spare_disks;
+		sysfs_free(info);
+	}
+}
+
 int Grow_reshape(char *devname, int fd,
 		 struct mddev_dev *devlist,
 		 struct context *c, struct shape *s)
@@ -1961,12 +1981,14 @@ int Grow_reshape(char *devname, int fd,
 			goto release;
 		}
 
-		if (s->raiddisks && subarray) {
+		if (s->raiddisks && subarray && !st->ss->subarray_raid_disks) {
 			pr_err("--raid-devices operation can be performed on a container only\n");
 			close(cfd);
 			free(subarray);
 			return 1;
 		}
+		if (s->raiddisks && subarray)
+			get_subarray_spares(st, subarray, &array);
 	}
 
 	added_disks = 0;
@@ -2360,16 +2382,8 @@ size_change_error:
 	} else {
 		/* get spare devices from external metadata
 		 */
-		if (st->ss->external) {
-			struct mdinfo *info2;
-
-			info2 = st->ss->container_content(st, subarray);
-			if (info2) {
-				info.array.spare_disks =
-					info2->array.spare_disks;
-				sysfs_free(info2);
-			}
-		}
+		if (st->ss->external)
+			get_subarray_spares(st, subarray, &info.array);
 
 		/* Impose these changes on a single array.  First
 		 * check that the metadata is OK with the change.
diff --git a/mdadm.h b/mdadm.h
index d5179112..b85e0f82 100644
--- a/mdadm.h
+++ b/mdadm.h
@@ -1269,6 +1269,12 @@ extern struct superswitch {
 
 	int swapuuid; /* true if uuid is bigending rather than hostendian */
 	int external;
+	/*
+	 * --grow --raid-devices of a subarray, not only of the container: the
+	 * metadata keeps the number of disks per subarray (AMD: a RAIDABLE
+	 * grows into a RAID1), unlike IMSM, where it is the container's.
+	 */
+	int subarray_raid_disks;
 	const char *name; /* canonical metadata name */
 } *superlist[];
 
