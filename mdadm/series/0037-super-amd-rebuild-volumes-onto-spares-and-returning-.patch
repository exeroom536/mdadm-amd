+				   &u->el) != 0) {
+			amd_kmsg("%s: md rebuilds member %d onto %d:%d at %llu, where AMD has no room for it: not recorded",
+				 a->info.sys_name, slot, d->major, d->minor,
+				 dev->data_offset);
+			return 0;
+		}
+		u->type = AMD_UPDATE_SPARE;
+		u->vol = a->info.container_member;
+		u->slot = slot;
+		return 1;
+	}
+	return 0;
+}
