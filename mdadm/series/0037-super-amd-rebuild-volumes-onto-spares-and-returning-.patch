-		    e->generation != d->generation ||
-		    e->committed_checksum != d->committed_checksum ||
-		    !amd_disk_had(e, v, &v->el[i]))
+		    e->generation != c->generation ||
+		    e->committed_checksum != c->checksum ||
+		    !amd_disk_had(e, v, el))
