@@ -1664,6 +1664,7 @@ extern int open_subarray(char *dev, char *subarray, struct supertype *st, int qu
 extern struct superswitch *version_to_superswitch(char *vers);
 
 extern mdadm_status_t wait_for_mdmon_control_socket(const char *container_devnm);
+extern bool is_zombie(pid_t pid);
 extern int mdmon_running(const char *devnm);
 extern int mdmon_pid(const char *devnm);
 extern mdadm_status_t wait_for_mdmon(const char *devnm);
diff --git a/mdmon.c b/mdmon.c
index 81b79493..2fc92bb8 100644
--- a/mdmon.c
+++ b/mdmon.c
@@ -167,35 +167,6 @@ static int make_pidfile(char *devname)
 	return 0;
 }
 
-/*
- * An mdmon that has exited but that nobody has reaped is a zombie: kill()
- * still finds it.  In the shutdown ramfs (systemd's exitrd, dracut's
- * shutdown) its parent is the shutdown program as pid 1, which does not
- * reap.
- */
-static bool is_zombie(pid_t pid)
-{
-	char buf[64];
-	char *p;
-	int fd;
-	int n;
-
-	sprintf(buf, "/proc/%lu/stat", (unsigned long) pid);
-	fd = open(buf, O_RDONLY);
-	if (fd < 0)
-		return false;
-
-	n = read(fd, buf, sizeof(buf)-1);
-	close(fd);
-	if (n <= 0)
-		return false;
-	buf[n] = 0;
-
-	/* "pid (comm) state ...": the last ')' ends comm */
-	p = strrchr(buf, ')');
-	return p && p[1] == ' ' && p[2] == 'Z';
-}
-
 static void try_kill_monitor(pid_t pid, char *devname, int sock)
 {
 	char buf[100];
diff --git a/util.c b/util.c
index 8b614ce8..0d91a7ff 100644
--- a/util.c
+++ b/util.c
@@ -1930,12 +1930,41 @@ int mdmon_pid(const char *devnm)
 	return atoi(pid);
 }
 
+/*
+ * An mdmon that has exited but that nobody has reaped is a zombie: kill()
+ * still finds it.  In the shutdown ramfs (systemd's exitrd, dracut's
+ * shutdown) its parent is the shutdown program as pid 1, which does not
+ * reap.
+ */
+bool is_zombie(pid_t pid)
+{
+	char buf[64];
+	char *p;
+	int fd;
+	int n;
+
+	sprintf(buf, "/proc/%lu/stat", (unsigned long) pid);
+	fd = open(buf, O_RDONLY);
+	if (fd < 0)
+		return false;
+
+	n = read(fd, buf, sizeof(buf)-1);
+	close(fd);
+	if (n <= 0)
+		return false;
+	buf[n] = 0;
+
+	/* "pid (comm) state ...": the last ')' ends comm */
+	p = strrchr(buf, ')');
+	return p && p[1] == ' ' && p[2] == 'Z';
+}
+
 int mdmon_running(const char *devnm)
 {
 	int pid = mdmon_pid(devnm);
 	if (pid <= 0)
 		return 0;
-	if (kill(pid, 0) == 0)
+	if (kill(pid, 0) == 0 && !is_zombie(pid))
 		return 1;
 	return 0;
 }
