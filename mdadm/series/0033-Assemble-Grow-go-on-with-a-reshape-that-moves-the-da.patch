From aa4993f81cbc11cf91f907e2c622806c6f89425d Mon Sep 17 00:00:00 2001
From: exeroom536 <352890649+exeroom536@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:53:14 +0500
Subject: [PATCH 33/62] Assemble, Grow: go on with a reshape that moves the
 data from its start

assemble_container_content() starts an array whose reshape is at 0 as
one still to start: it clears the reshape position, which drops md's new
geometry, and starts the array active for Grow_continue() to start the
reshape anew.  That is what IMSM needs: md cannot go on with an in-place
reshape from its very start (raid5.c run(): "reshape_position too early
for auto-recovery").

A reshape that moves the data to other offsets, recorded by the metadata
(new_data_offset), md goes on with from 0 as from any other point: it
writes the new layout where it does not read the old one.  Clearing the
reshape position takes the new offsets and delta_disks with it, while
raid_disks stays the new number: md would run the new number of disks
over data still in the old layout.  AMD RAIDXpert2 (later in this
series) records a migration before anything has moved, and its driver
goes on with one stopped before the first region from 0, as with one
stopped later from the mark of its log.

Start such an array read-only, as one midway, and let reshape_array()
go on with it when md has its reshape position, rather than taking it
for a reshape that is still to start.  IMSM gives no new offsets, and md
has no reshape position of an IMSM array assembled at 0: nothing changes
for it (upstream's IMSM grow tests 12imsm-r5_3d-grow-r5_4d,
13imsm-r0_r0_2d-grow-r0_r0_4d, 13imsm-r5_r0_3d-grow-r5_r0_4d and
14imsm-r0_3d-r5_3d-migrate-r5_4d-r5_4d pass with this and the next
patch).

Written by Claude Opus 5.5, an AI model by Anthropic.
---
 Assemble.c | 26 +++++++++++++++++++++++++-
 Grow.c     | 14 ++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/Assemble.c b/Assemble.c
index b4f7e1f6..b117c717 100644
--- a/Assemble.c
+++ b/Assemble.c
@@ -2026,6 +2026,23 @@ static void mdmon_take_array(char *container_devnm)
 	close_fd(&fd);
 }
 
+/*
+ * The reshape of @content moves the data to other offsets, which the
+ * metadata records (new_data_offset): md writes the new layout where it
+ * does not read the old, so it can go on with it from any point - from
+ * the very start too.
+ */
+static bool reshape_moves_data(struct mdinfo *content)
+{
+	struct mdinfo *dev;
+
+	for (dev = content->devs; dev; dev = dev->next)
+		if (dev->new_data_offset &&
+		    dev->new_data_offset != dev->data_offset)
+			return true;
+	return false;
+}
+
 int assemble_container_content(struct supertype *st, int mdfd,
 			       struct mdinfo *content, struct context *c,
 			       char *chosen_name, int *result)
@@ -2244,7 +2261,14 @@ int assemble_container_content(struct supertype *st, int mdfd,
 				   spare, &c->backup_file, c->verbose) == 1)
 			return 1;
 
-		if (content->reshape_progress == 0) {
+		/*
+		 * One that moves the data goes on from 0 as from any other
+		 * point: started anew, md would drop the new offsets with the
+		 * reshape position and run the new geometry over the data,
+		 * still in the old one.
+		 */
+		if (content->reshape_progress == 0 &&
+		    !reshape_moves_data(content)) {
 			/* If reshape progress is 0 - we are assembling the
 			 * array that was stopped, before reshape has started.
 			 * Array needs to be started as active, Grow_continue()
diff --git a/Grow.c b/Grow.c
index 1fc6960a..321bd66e 100644
--- a/Grow.c
+++ b/Grow.c
@@ -2465,6 +2465,17 @@ release:
 	return rv;
 }
 
+/*
+ * md has a reshape of @info in hand: it was started with the reshape
+ * position of the metadata (reshape_position is "none" otherwise).
+ */
+static bool md_reshape_pending(struct mdinfo *info)
+{
+	unsigned long long position;
+
+	return sysfs_get_ll(info, NULL, "reshape_position", &position) == 0;
+}
+
 /* verify_reshape_position()
  *	Function checks if reshape position in metadata is not farther
  *	than position in md.
@@ -3299,6 +3310,7 @@ static int reshape_array(char *container, int fd, char *devname,
 	}
 
 	if (st->ss->external && restart && (info->reshape_progress == 0) &&
+	    !md_reshape_pending(info) &&
 	    !((sysfs_get_str(info, NULL, "sync_action",
 			     buf, sizeof(buf)) > 0) &&
 	      (strncmp(buf, "reshape", 7) == 0))) {
@@ -3308,6 +3320,8 @@ static int reshape_array(char *container, int fd, char *devname,
 		 * Check if md has the same opinion, and reshape is restarted
 		 * from 0. If so, this is regular reshape start after reshape
 		 * switch in metadata to next array only.
+		 * md that has the reshape position already (one that moves
+		 * the data, assembled at 0) goes on from there.
 		 */
 		if ((verify_reshape_position(info, reshape.level) >= 0) &&
 		    (info->reshape_progress == 0))
